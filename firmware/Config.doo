object Config

// Configurações como aplicativo: volume, tema, endereço da loja (pelo teclado da tela) e a tela "sobre".
// O XMB abre e sai de cena, do mesmo jeito que na loja.

var xmb
var aberta = false
var canvas
var sVolume
var bTema
var cLoja
var bControles
var controles        // a tela de controles (Controles.doo)
var temaNomes = ["Azul", "Verde", "Roxo", "Laranja", "Grafite"]
var urlSalva = ""    // último endereço guardado, para saber quando mudou de verdade
var resumo = ""      // quantos jogos e quanto ocupam; medir disco é caro, então só ao abrir

function create() {
    canvas = instance_create(Canvas)
    canvas.visible = false
    canvas.active = false
    sVolume = canvas.slider("Volume", 20, 34, 280, 0, 100, save_get("volume", 80))
    bTema = canvas.button("Tema", 20, 60, 280, 18)
    cLoja = canvas.field("Loja", 20, 86, 280, save_get("loja", "http://localhost:8080"))
    cLoja.max = 60
    urlSalva = cLoja.value
    bControles = canvas.button("Controles", 20, 112, 280, 18)
}

function abrir() {
    aberta = true
    resumo = medirJogos()
    canvas.visible = true
    canvas.active = false   // espera soltar o A que abriu
    canvas.tint(xmb.corTema())
    canvas.focus_on(sVolume)
}

function fechar() {
    aberta = false
    canvas.visible = false
    canvas.active = false
    if (xmb) { xmb.voltar() }
}

function voltar() {   // a tela de controles fechou
    canvas.visible = true
    canvas.active = false   // espera soltar o B que fechou a outra tela
    audio_play_tone(520, 50)
}

function step() {
    if (!aberta) { return }
    if (controles && controles.aberta) { return }
    if (!canvas.active && !button_check(btn_a) && !button_check(btn_b)) { canvas.active = true }
    bTema.text = "Tema: " + temaNomes[xmb.tema]
    if (sVolume.changed) {
        xmb.volume = sVolume.value
        system_volume(sVolume.value / 100)
        save_set("volume", sVolume.value)
    }
    if (bControles.clicked) {
        if (!controles) {
            controles = instance_create(Controles)
            controles.config = self
            controles.xmb = xmb
        }
        canvas.visible = false
        canvas.active = false
        controles.abrir()
        audio_play_tone(880, 60)
    }
    if (bTema.clicked) {
        xmb.tema = (xmb.tema + 1) % array_length(temaNomes)
        save_set("tema", xmb.tema)
        canvas.tint(xmb.corTema())   // o tema novo vale já nesta tela
        audio_play_tone(660, 40)
    }
    if (!cLoja.holding() && cLoja.value != urlSalva) {   // fechou o teclado com um endereço novo
        urlSalva = cLoja.value
        store_set_url(urlSalva)
        save_set("loja", urlSalva)
        audio_play_tone(880, 60)
    }
    if (button_check_pressed(btn_b) && !cLoja.holding()) { fechar() }
}

function draw() {
    if (!aberta || (controles && controles.aberta)) { return }
    xmb.fundoApp("CONFIGURAÇÕES", "Doodle 0.1")

    draw_text(20, 135, "Tela 320 x 180 (16:9) a 60 quadros por segundo", 9, 0xD8DCE4, 0.9)
    draw_text(20, 145, resumo + "   " + estadoLoja(), 9, 0xD8DCE4, 0.9)
    draw_text(20, 155, "Linguagem Doo, no formato da GML", 9, 0xD8DCE4, 0.9)

    var dica = "A altera   Esq/Dir ajusta   B volta"
    if (cLoja.holding()) { dica = "Escrevendo o endereço da loja" }
    draw_text(6, 167, dica, 9, 0xFFFFFF, 0.75)
}

function medirJogos() {
    var jogos = game_list()
    var bytes = 0
    for (var i = 0; i < array_length(jogos); i += 1) {
        bytes += game_size(jogos[i])
    }
    var quanto = max(1, floor(bytes / 1024)) + " KB"
    if (bytes >= 1048576) { quanto = floor(bytes / 104857.6) / 10 + " MB" }
    return array_length(jogos) + " jogos instalados (" + quanto + ")"
}

function estadoLoja() {
    if (store_error() != "") { return "loja: sem resposta" }
    if (store_ready()) { return "loja no ar" }
    return "loja não consultada"
}
