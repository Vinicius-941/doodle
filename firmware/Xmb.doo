object Xmb

// Menu do sistema no estilo XMB (PS3/PSP): categorias na horizontal (esquerda/direita),
// itens da categoria na vertical (cima/baixo). A abre, B volta, Y mostra as opções de um jogo.

var cats = ["Configurações", "Jogos", "Loja"]
var icones = ["firmware/icones/config.png", "firmware/icones/jogos.png", "firmware/icones/loja.png"]
var cat = 1          // categoria atual (começa em Jogos)
var sel = [0, 0, 0]  // item escolhido em cada categoria
var cx = 1           // posições animadas, que correm atrás de cat e de sel[cat]
var sy = 0
var col = 150        // coluna das categorias e dos itens
var row = 112        // linha dos ícones das categorias
var t = 0
var fade = 0         // entrada suave depois do boot

var jogos = []       // pastas em games/
var titulos = []

var volume = 80      // configurações, salvas em saves/sistema.sav
var tema = 0
var temaNomes = ["Azul", "Verde", "Roxo", "Laranja", "Grafite"]
var temaCores = [0x2A5BD7, 0x2E9A5A, 0x7A3FC0, 0xD0702A, 0x5A6070]

var loja = []        // ids do catálogo da loja
var lojaTitulos = []
var lojaCarregada = false
var baixando = ""    // id sendo instalado agora ("" = nenhum)

var modo = ""        // "" navegando | "editar" (ajustando uma configuração) | "painel" | "opcoes"
var painel = []      // linhas do painel de informação aberto
var opcao = 0        // linha escolhida no menu de opções do jogo
var opcoesNomes = ["Iniciar", "Apagar dados salvos", "Cancelar"]

function create() {
    listarJogos()
    store_set_url(save_get("loja", "http://localhost:8080"))
    store_refresh()
    volume = save_get("volume", 80)
    tema = max(0, min(array_length(temaNomes) - 1, save_get("tema", 0)))
    system_volume(volume / 100)
}

// ---------- entrada ----------

function step() {
    var dt = delta_time
    t += dt
    acompanharLoja()
    fade = min(1, fade + dt * 1.6)
    if (fade == 1) {   // sem entrada durante a transição do boot
        if (modo == "editar") {
            editar()
        } else if (modo == "painel") {
            if (button_check_pressed(btn_a) || button_check_pressed(btn_b)) {
                modo = ""
                audio_play_tone(520, 50)
            }
        } else if (modo == "opcoes") {
            opcoes()
        } else {
            navegar()
        }
    }
    var k = min(1, dt * 12)
    cx += (cat - cx) * k
    sy += (sel[cat] - sy) * k
}

function listarJogos() {
    jogos = game_list()
    titulos = []
    for (var i = 0; i < array_length(jogos); i += 1) {
        array_push(titulos, game_title(jogos[i]))
    }
}

// A loja trabalha numa thread do simulador: aqui só se olha o resultado, sem travar o quadro.
function acompanharLoja() {
    if (store_ready() && !lojaCarregada) {
        loja = store_available()
        lojaTitulos = []
        for (var i = 0; i < array_length(loja); i += 1) {
            array_push(lojaTitulos, store_title(loja[i]))
        }
        lojaCarregada = true
    }
    if (baixando != "" && !store_busy()) {
        var erro = store_error()
        baixando = ""
        listarJogos()
        if (erro == "") {
            audio_play_tone(988, 120)
        } else {
            mostrar(["Não deu", erro])
        }
    }
}

function navegar() {
    var c = cat
    if (button_check_pressed(btn_right) && cat < 2) { cat += 1 }
    if (button_check_pressed(btn_left) && cat > 0) { cat -= 1 }
    if (cat != c) {
        sy = sel[cat]
        tique()
    }
    if (button_check_pressed(btn_down) && sel[cat] < contar(cat) - 1) {
        sel[cat] += 1
        tique()
    }
    if (button_check_pressed(btn_up) && sel[cat] > 0) {
        sel[cat] -= 1
        tique()
    }
    if (button_check_pressed(btn_a)) {
        abrir(cat, sel[cat])
    }
    if (button_check_pressed(btn_x) && cat == 2 && !store_busy()) {
        lojaCarregada = false
        store_refresh()
        tique()
    }
    if (button_check_pressed(btn_y) && cat == 1 && array_length(jogos) > 0) {
        modo = "opcoes"
        opcao = 0
        opcoesNomes = ["Iniciar", "Apagar dados salvos", "Cancelar"]
        if (store_can_uninstall(jogos[sel[1]])) {
            opcoesNomes = ["Iniciar", "Apagar dados salvos", "Desinstalar", "Cancelar"]
        }
        audio_play_tone(880, 50)
    }
}

function abrir(c, i) {
    if (c == 0 && i < 2) {
        modo = "editar"
        audio_play_tone(880, 50)
    } else if (c == 0) {
        mostrar(["Doodle", "Firmware 0.1 - linguagem Doo", "Tela 640 x 480 a 60 quadros por segundo", "Simulador para Windows"])
    } else if (c == 1) {
        if (array_length(jogos) > 0) {
            iniciar(jogos[i])
        }
    } else {
        abrirLoja(i)
    }
}

function abrirLoja(i) {
    if (array_length(loja) == 0) {
        mostrar(["Loja Doodle", estadoLoja(), "Servidor: " + save_get("loja", "http://localhost:8080"), "X: tentar de novo"])
        return
    }
    var id = loja[i]
    if (game_installed(id)) {
        iniciar(id)
        return
    }
    if (store_busy()) {
        return
    }
    baixando = id
    store_install(id)
    audio_play_tone(660, 80)
}

function estadoLoja() {
    if (store_error() != "") { return store_error() }
    if (store_busy()) { return "Conectando..." }
    if (store_ready()) { return "A loja está vazia." }
    return "Sem resposta da loja."
}

function editar() {
    var d = 0
    if (button_check_pressed(btn_right)) { d = 1 }
    if (button_check_pressed(btn_left)) { d = -1 }
    if (d != 0) {
        if (sel[0] == 0) {
            volume = max(0, min(100, volume + d * 10))
            system_volume(volume / 100)
        } else {
            tema = (tema + d + array_length(temaNomes)) % array_length(temaNomes)
        }
        tique()
    }
    if (button_check_pressed(btn_a) || button_check_pressed(btn_b)) {
        save_set("volume", volume)
        save_set("tema", tema)
        modo = ""
        audio_play_tone(520, 50)
    }
}

function opcoes() {
    if (button_check_pressed(btn_down) && opcao < array_length(opcoesNomes) - 1) {
        opcao += 1
        tique()
    }
    if (button_check_pressed(btn_up) && opcao > 0) {
        opcao -= 1
        tique()
    }
    if (button_check_pressed(btn_b)) {
        modo = ""
        audio_play_tone(520, 50)
    }
    if (button_check_pressed(btn_a)) {
        var id = jogos[sel[1]]
        var escolha = opcoesNomes[opcao]
        modo = ""
        if (escolha == "Iniciar") { iniciar(id) }
        if (escolha == "Apagar dados salvos") {
            system_delete_save(id)
            audio_play_tone(330, 150)
        }
        if (escolha == "Desinstalar") {
            store_uninstall(id)
            listarJogos()
            sel[1] = max(0, min(sel[1], array_length(jogos) - 1))
            audio_play_tone(330, 150)
        }
    }
}

function iniciar(id) {
    audio_play_tone(988, 120)
    system_launch(id)
}

function mostrar(linhas) {
    painel = linhas
    modo = "painel"
    audio_play_tone(880, 50)
}

function tamanho(id) {
    var b = store_size(id)
    if (b >= 1048576) { return floor(b / 104857.6) / 10 + " MB" }
    return max(1, floor(b / 1024)) + " KB"
}

function tique() {
    audio_play_tone(660, 30)
}

// ---------- itens ----------

function contar(c) {
    if (c == 0) { return 3 }
    if (c == 1) { return max(1, array_length(jogos)) }
    return max(1, array_length(loja))
}

function rotulo(c, i) {
    if (c == 0) { return ["Volume", "Tema", "Sobre o Doodle"][i] }
    if (c == 1) { return "Nenhum jogo instalado" }
    return "Loja Doodle"
}

function valor(c, i) {
    if (c == 0 && i == 0) { return volume + "%" }
    if (c == 0 && i == 1) { return temaNomes[tema] }
    return ""
}

function dica(c, i) {
    if (c == 0 && i < 2) { return "A: ajustar" }
    if (c == 0) { return "Versão do sistema" }
    if (c == 1) { return "Coloque jogos na pasta games/" }
    return estadoLoja()
}

// ---------- desenho ----------

function draw() {
    fundo()

    var hora = clock_date() + "   " + clock_time()
    draw_text(610 - string_width(hora, 18), 20, hora, 18, 0xFFFFFF)

    for (var c = 0; c < 3; c += 1) {
        var x = col + (c - cx) * 130
        var s = 44
        var a = 0.5
        if (c == cat) {
            s = 60
            a = 1
        }
        draw_sprite(icones[c], x - s / 2, row - s / 2, s, s, a)
    }
    centrado(col, row + 36, cats[cat], 16, 1)

    var n = contar(cat)
    for (var i = 0; i < n; i += 1) {   // o item escolhido fica logo abaixo das categorias; os anteriores, acima
        var d = i - sy
        var y = 210 + d * 64
        if (d < 0) { y = 210 + d * 164 }
        if (d < -1) { y = 46 + (d + 1) * 64 }
        if (y > -50 && y < 470) {
            item(cat, i, y, i == sel[cat])
        }
    }

    if (modo == "painel") {
        draw_rectangle(0, 0, 640, 480, 0x000000, 0.88)
        for (var i = 0; i < array_length(painel); i += 1) {
            var tam = 18
            if (i == 0) { tam = 30 }
            centrado(320, 140 + i * 42, painel[i], tam, 1)
        }
        centrado(320, 400, "A ou B: voltar", 15, 0.8)
    }
    if (modo == "opcoes") {   // menu lateral, como o do triângulo no PS3
        draw_rectangle(0, 0, 640, 480, 0x000000, 0.4)
        draw_rectangle(380, 0, 260, 480, 0x0A1020, 0.9)
        draw_text(396, 150, titulos[sel[1]], 20, 0xFFFFFF)
        for (var i = 0; i < array_length(opcoesNomes); i += 1) {
            var oy = 196 + i * 38
            if (i == opcao) { draw_rectangle(384, oy - 6, 252, 34, 0xFFFFFF, 0.15) }
            draw_text(400, oy, opcoesNomes[i], 18, 0xFFFFFF)
        }
    }

    var dicas = "A: abrir      Esquerda/Direita: categorias"
    if (cat == 1) { dicas = "A: jogar      Y: opções      Esquerda/Direita: categorias" }
    if (cat == 2) {
        dicas = "A: instalar ou jogar      X: atualizar a lista"
        if (store_busy()) { dicas = "Loja: falando com o servidor..." }
        if (store_error() != "") { dicas = "Loja: " + store_error() }
    }
    if (modo == "editar") { dicas = "Esquerda/Direita: ajustar      A: confirmar" }
    if (modo == "opcoes") { dicas = "A: confirmar      B: voltar" }
    if (modo != "painel") { draw_text(30, 450, dicas, 14, 0xFFFFFF, 0.75) }

    if (fade < 1) {   // sai do preto do boot
        draw_rectangle(0, 0, 640, 480, 0x000000, 1 - fade)
    }
}

function item(c, i, y, on) {
    var a = 0.6
    if (on) {
        a = 1
        draw_rectangle(col - 50, y - 38, 520, 76, 0xFFFFFF, 0.07 + 0.04 * sin(t * 3))   // brilho pulsando
    }
    if (c == 1 && array_length(jogos) > 0) {
        var w = 96
        var h = 53
        if (on) {
            w = 128
            h = 70
        }
        if (!draw_sprite("games/" + jogos[i] + "/icon.png", col - 40, y - h / 2, w, h, a)) {
            draw_rectangle(col - 40, y - h / 2, w, h, 0x607090, a)
        }
        draw_text(col + 100, y - 16, titulos[i], 24, 0xFFFFFF, a)
        if (on) {
            var info = "Sem dados salvos"
            if (game_save_data(jogos[i]) != "") { info = "Dados salvos" }
            draw_text(col + 100, y + 14, info, 14, 0xE0E8FF, 0.85)
        }
        return
    }
    if (c == 2 && array_length(loja) > 0) {
        var id = loja[i]
        draw_sprite(icones[2], col - 16, y - 16, 32, 32, a)
        draw_text(col + 30, y - 14, lojaTitulos[i], 22, 0xFFFFFF, a)
        var estado = tamanho(id)
        if (game_installed(id)) { estado = "Instalado" }
        if (baixando == id) { estado = floor(store_progress() * 100) + "%" }
        draw_text(600 - string_width(estado, 18), y - 12, estado, 18, 0xFFFFFF, a)
        if (baixando == id) {
            draw_rectangle(col + 30, y + 18, 400, 6, 0x000000, 0.4 * a)
            draw_rectangle(col + 30, y + 18, 400 * store_progress(), 6, 0x7BD36B, a)
        } else if (on) {
            draw_text(col + 30, y + 14, store_info(id), 14, 0xE0E8FF, 0.85)
        }
        return
    }
    draw_sprite(icones[c], col - 16, y - 16, 32, 32, a)
    draw_text(col + 30, y - 14, rotulo(c, i), 22, 0xFFFFFF, a)
    var v = valor(c, i)
    if (v != "" && y > row) {   // itens acima das categorias mostram só o nome
        if (on && modo == "editar") { v = "<   " + v + "   >" }
        draw_text(600 - string_width(v, 20), y - 12, v, 20, 0xFFFFFF, a)
    }
    if (on) {
        draw_text(col + 30, y + 14, dica(c, i), 14, 0xE0E8FF, 0.85)
    }
}

function fundo() {   // gradiente na cor do tema + onda de luz ondulando, como no PS3
    var c = temaCores[tema]
    draw_gradient(0, 0, 640, 480, escuro(c, 0.2), c)
    for (var camada = 0; camada < 2; camada += 1) {
        var v = 0.35 + camada * 0.25
        for (var x = 0; x < 640; x += 4) {
            var y = 330 + sin(x * 0.009 + t * v + camada * 2.1) * (34 + camada * 14) + sin(x * 0.023 - t * 0.7) * 8
            draw_gradient(x, y - 26, 4, 26, 0xFFFFFF, 0xFFFFFF, 0, 0.12)
            draw_gradient(x, y, 4, 26, 0xFFFFFF, 0xFFFFFF, 0.12, 0)
        }
    }
}

function escuro(c, k) {   // a mesma cor com brilho k (0..1)
    return make_color_rgb(floor(c / 65536) % 256 * k, floor(c / 256) % 256 * k, c % 256 * k)
}

function centrado(x, y, s, size, a) {
    draw_text(x - string_width(s, size) / 2, y, s, size, 0xFFFFFF, a)
}
