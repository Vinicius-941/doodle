object Xmb

// Menu do sistema no estilo XMB (PS3/PSP): categorias na horizontal (esquerda/direita),
// itens da categoria na vertical (cima/baixo). A abre, B volta, Y mostra as opções de um jogo.

var cats = ["Configurações", "Jogos", "Loja"]
var icones = ["firmware/icones/config.png", "firmware/icones/jogos.png", "firmware/icones/loja.png"]
var cat = 1          // categoria atual (começa em Jogos)
var sel = [0, 0, 0]  // item escolhido em cada categoria
var cx = 1           // posições animadas, que correm atrás de cat e de sel[cat]
var sy = 0
var col = 74         // coluna das categorias e dos itens
var row = 44         // linha dos ícones das categorias
var t = 0
var fade = 0         // entrada suave depois do boot

var jogos = []       // pastas em games/
var titulos = []

var volume = 80      // configurações, salvas em saves/sistema.sav
var tema = 0
var temaNomes = ["Azul", "Verde", "Roxo", "Laranja", "Grafite"]
var temaCores = [0x2A5BD7, 0x2E9A5A, 0x7A3FC0, 0xD0702A, 0x5A6070]

var loja             // o aplicativo da loja (Loja.doo), criado na primeira vez que abre

var modo = ""        // "" navegando | "editar" (ajustando uma configuração) | "painel" | "opcoes"
var painel = []      // linhas do painel de informação aberto
var opcao = 0        // linha escolhida no menu de opções do jogo
var opcoesNomes = ["Iniciar", "Apagar dados salvos", "Cancelar"]

function create() {
    listarJogos()
    volume = save_get("volume", 80)
    tema = max(0, min(array_length(temaNomes) - 1, save_get("tema", 0)))
    system_volume(volume / 100)
}

// ---------- entrada ----------

function step() {
    var dt = delta_time
    t += dt
    if (loja && loja.aberta) { return }   // a loja está no ar: o menu sai de cena
    fade = min(1, fade + dt * 1.6)
    if (fade == 1) {   // sem entrada durante a transição do boot
        if (modo == "editar") {
            editar()
        } else if (modo == "painel") {
            if (button_check_pressed(btn_a) || button_check_pressed(btn_b)) {
                modo = ""
                audio_play_tone(520, 50)
            }
        } else if (modo == "opcoes") {
            opcoes()
        } else {
            navegar()
        }
    }
    var k = min(1, dt * 12)
    cx += (cat - cx) * k
    sy += (sel[cat] - sy) * k
}

function listarJogos() {
    jogos = game_list()
    titulos = []
    for (var i = 0; i < array_length(jogos); i += 1) {
        array_push(titulos, game_title(jogos[i]))
    }
}

function voltar() {   // a loja fechou: o menu volta, com a lista de jogos atualizada
    listarJogos()
    audio_play_tone(520, 50)
}

function navegar() {
    var c = cat
    if (button_check_pressed(btn_right) && cat < 2) { cat += 1 }
    if (button_check_pressed(btn_left) && cat > 0) { cat -= 1 }
    if (cat != c) {
        sy = sel[cat]
        tique()
    }
    if (button_check_pressed(btn_down) && sel[cat] < contar(cat) - 1) {
        sel[cat] += 1
        tique()
    }
    if (button_check_pressed(btn_up) && sel[cat] > 0) {
        sel[cat] -= 1
        tique()
    }
    if (button_check_pressed(btn_a)) {
        abrir(cat, sel[cat])
    }
    if (button_check_pressed(btn_y) && cat == 1 && array_length(jogos) > 0) {
        modo = "opcoes"
        opcao = 0
        opcoesNomes = ["Iniciar", "Apagar dados salvos", "Cancelar"]
        if (store_can_uninstall(jogos[sel[1]])) {
            opcoesNomes = ["Iniciar", "Apagar dados salvos", "Desinstalar", "Cancelar"]
        }
        audio_play_tone(880, 50)
    }
}

function abrir(c, i) {
    if (c == 0 && i < 2) {
        modo = "editar"
        audio_play_tone(880, 50)
    } else if (c == 0) {
        mostrar(["Doodle", "Firmware 0.1 - linguagem Doo", "Tela 320 x 180 (16:9) a 60 quadros", "Simulador para Windows"])
    } else if (c == 1) {
        if (array_length(jogos) > 0) {
            iniciar(jogos[i])
        }
    } else {
        if (!loja) {
            loja = instance_create(Loja)
            loja.xmb = self
        }
        loja.abrir()
        audio_play_tone(880, 60)
    }
}

function editar() {
    var d = 0
    if (button_check_pressed(btn_right)) { d = 1 }
    if (button_check_pressed(btn_left)) { d = -1 }
    if (d != 0) {
        if (sel[0] == 0) {
            volume = max(0, min(100, volume + d * 10))
            system_volume(volume / 100)
        } else {
            tema = (tema + d + array_length(temaNomes)) % array_length(temaNomes)
        }
        tique()
    }
    if (button_check_pressed(btn_a) || button_check_pressed(btn_b)) {
        save_set("volume", volume)
        save_set("tema", tema)
        modo = ""
        audio_play_tone(520, 50)
    }
}

function opcoes() {
    if (button_check_pressed(btn_down) && opcao < array_length(opcoesNomes) - 1) {
        opcao += 1
        tique()
    }
    if (button_check_pressed(btn_up) && opcao > 0) {
        opcao -= 1
        tique()
    }
    if (button_check_pressed(btn_b)) {
        modo = ""
        audio_play_tone(520, 50)
    }
    if (button_check_pressed(btn_a)) {
        var id = jogos[sel[1]]
        var escolha = opcoesNomes[opcao]
        modo = ""
        if (escolha == "Iniciar") { iniciar(id) }
        if (escolha == "Apagar dados salvos") {
            system_delete_save(id)
            audio_play_tone(330, 150)
        }
        if (escolha == "Desinstalar") {
            store_uninstall(id)
            listarJogos()
            sel[1] = max(0, min(sel[1], array_length(jogos) - 1))
            audio_play_tone(330, 150)
        }
    }
}

function iniciar(id) {
    audio_play_tone(988, 120)
    system_launch(id)
}

function mostrar(linhas) {
    painel = linhas
    modo = "painel"
    audio_play_tone(880, 50)
}

function cortar(s, largura, tam) {   // encurta até caber, com reticências
    if (string_width(s, tam) <= largura) { return s }
    while (string_length(s) > 4 && string_width(s + "...", tam) > largura) {
        s = string_copy(s, 1, string_length(s) - 1)
    }
    return s + "..."
}

function tique() {
    audio_play_tone(660, 30)
}

// ---------- itens ----------

function contar(c) {
    if (c == 0) { return 3 }
    if (c == 1) { return max(1, array_length(jogos)) }
    return 1
}

function rotulo(c, i) {
    if (c == 0) { return ["Volume", "Tema", "Sobre o Doodle"][i] }
    if (c == 1) { return "Nenhum jogo instalado" }
    return "Abrir a loja"
}

function valor(c, i) {
    if (c == 0 && i == 0) { return volume + "%" }
    if (c == 0 && i == 1) { return temaNomes[tema] }
    return ""
}

function dica(c, i) {
    if (c == 0 && i < 2) { return "A: ajustar" }
    if (c == 0) { return "Versão do sistema" }
    if (c == 1) { return "Ponha jogos em games/" }
    return "Baixar jogos novos"
}

// ---------- desenho ----------

function draw() {
    if (loja && loja.aberta) { return }   // quem desenha agora é a loja
    fundo()

    var hora = clock_date() + "  " + clock_time()
    draw_text(312 - string_width(hora, 10), 6, hora, 10, 0xFFFFFF)

    for (var c = 0; c < 3; c += 1) {
        var x = col + (c - cx) * 66
        var s = 22
        var a = 0.5
        if (c == cat) {
            s = 30
            a = 1
        }
        draw_sprite(icones[c], x - s / 2, row - s / 2, s, s, a)
    }
    centrado(col, row + 16, cats[cat], 10, 1)

    var n = contar(cat)
    for (var i = 0; i < n; i += 1) {   // o item escolhido fica logo abaixo das categorias; os anteriores, acima
        var d = i - sy
        var y = 95 + d * 30
        if (d < 0) { y = 95 + d * 64 }
        if (d < -1) { y = 22 + (d + 1) * 30 }
        if (y > -20 && y < 178) {
            item(cat, i, y, i == sel[cat])
        }
    }

    if (modo == "painel") {
        draw_rectangle(0, 0, 320, 180, 0x000000, 0.88)
        for (var i = 0; i < array_length(painel); i += 1) {
            var tam = 10
            if (i == 0) { tam = 16 }
            centrado(160, 42 + i * 20, painel[i], tam, 1)
        }
        centrado(160, 158, "A ou B: voltar", 10, 0.8)
    }
    if (modo == "opcoes") {   // menu lateral, como o do triângulo no PS3
        draw_rectangle(0, 0, 320, 180, 0x000000, 0.4)
        draw_rectangle(188, 0, 132, 180, 0x0A1020, 0.9)
        draw_text(196, 50, cortar(titulos[sel[1]], 118, 10), 10, 0xFFFFFF)
        for (var i = 0; i < array_length(opcoesNomes); i += 1) {
            var oy = 76 + i * 18
            if (i == opcao) { draw_rectangle(190, oy - 3, 128, 16, 0xFFFFFF, 0.15) }
            draw_text(198, oy, opcoesNomes[i], 10, 0xFFFFFF)
        }
    }

    var dicas = "A: abrir    Esq/Dir: muda"
    if (cat == 1) { dicas = "A: jogar    Y: opções" }
    if (modo == "editar") { dicas = "Esq/Dir: ajusta    A: ok" }
    if (modo == "opcoes") { dicas = "A: confirmar    B: voltar" }
    if (modo != "painel") { draw_text(12, 166, dicas, 10, 0xFFFFFF, 0.75) }

    if (fade < 1) {   // sai do preto do boot
        draw_rectangle(0, 0, 320, 180, 0x000000, 1 - fade)
    }
}

function item(c, i, y, on) {
    var a = 0.6
    if (on) {
        a = 1
        draw_rectangle(col - 24, y - 17, 262, 34, 0xFFFFFF, 0.07 + 0.04 * sin(t * 3))   // brilho pulsando
    }
    if (c == 1 && array_length(jogos) > 0) {
        var w = 44
        var h = 25
        if (on) {
            w = 58
            h = 33
        }
        if (!draw_sprite("games/" + jogos[i] + "/icon.png", col - 20, y - h / 2, w, h, a)) {
            draw_rectangle(col - 20, y - h / 2, w, h, 0x607090, a)
        }
        draw_text(col + 46, y - 9, titulos[i], 11, 0xFFFFFF, a)
        if (on) {
            var info = "Sem dados salvos"
            if (game_save_data(jogos[i]) != "") { info = "Dados salvos" }
            draw_text(col + 46, y + 4, info, 9, 0xE0E8FF, 0.85)
        }
        return
    }
    draw_sprite(icones[c], col - 8, y - 8, 16, 16, a)
    draw_text(col + 16, y - 9, rotulo(c, i), 11, 0xFFFFFF, a)
    var v = valor(c, i)
    if (v != "" && y > row) {   // itens acima das categorias mostram só o nome
        if (on && modo == "editar") { v = "<  " + v + "  >" }
        draw_text(302 - string_width(v, 10), y - 8, v, 10, 0xFFFFFF, a)
    }
    if (on) {
        draw_text(col + 16, y + 3, dica(c, i), 9, 0xE0E8FF, 0.85)
    }
}

function fundo() {   // gradiente na cor do tema + onda de luz ondulando, como no PS3
    var c = temaCores[tema]
    draw_gradient(0, 0, 320, 180, escuro(c, 0.2), c)
    for (var camada = 0; camada < 2; camada += 1) {
        var v = 0.35 + camada * 0.25
        for (var x = 0; x < 320; x += 2) {
            var y = 124 + sin(x * 0.018 + t * v + camada * 2.1) * (13 + camada * 5) + sin(x * 0.046 - t * 0.7) * 3
            draw_gradient(x, y - 10, 2, 10, 0xFFFFFF, 0xFFFFFF, 0, 0.12)
            draw_gradient(x, y, 2, 10, 0xFFFFFF, 0xFFFFFF, 0.12, 0)
        }
    }
}

function escuro(c, k) {   // a mesma cor com brilho k (0..1)
    return make_color_rgb(floor(c / 65536) % 256 * k, floor(c / 256) % 256 * k, c % 256 * k)
}

function centrado(x, y, s, size, a) {
    draw_text(x - string_width(s, size) / 2, y, s, size, 0xFFFFFF, a)
}
