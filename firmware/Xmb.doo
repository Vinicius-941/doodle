object Xmb

// Menu do sistema no estilo XMB (PS3/PSP): categorias na horizontal (esquerda/direita),
// itens da categoria na vertical (cima/baixo). A abre, B volta, Y abre a tela do jogo escolhido.

var cats = ["Configurações", "Jogos", "Loja"]
var icones = ["firmware/icones/config.png", "firmware/icones/jogos.png", "firmware/icones/loja.png"]
var cat = 1          // categoria atual (começa em Jogos)
var sel = [0, 0, 0]  // item escolhido em cada categoria
var cx = 1           // posições animadas, que correm atrás de cat e de sel[cat]
var sy = 0
var col = 74         // coluna das categorias e dos itens
var row = 44         // linha dos ícones das categorias
var t = 0
var fade = 0         // entrada suave depois do boot

var jogos = []       // pastas em games/
var titulos = []

var volume = 80      // configurações, salvas em saves/sistema.sav
var tema = 0
var temaNomes = ["Azul", "Verde", "Roxo", "Laranja", "Grafite"]
var temaCores = [0x2A5BD7, 0x2E9A5A, 0x7A3FC0, 0xD0702A, 0x5A6070]

var raiz             // o objeto do boot (main.doo), que sabe desligar o console
var loja             // o aplicativo da loja (Loja.doo), criado na primeira vez que abre
var config           // o aplicativo de configurações (Config.doo)
var telaJogo         // a tela de detalhes do jogo (Jogo.doo)

var confirmando = false   // pergunta do desligar na tela
var desligando = 0        // fade para o preto antes de fechar
var baixava = false       // tinha download da loja rolando no quadro anterior

function create() {
    listarJogos()
    volume = save_get("volume", 80)
    tema = max(0, min(array_length(temaNomes) - 1, save_get("tema", 0)))
    system_volume(volume / 100)
}

// ---------- entrada ----------

function step() {
    var dt = delta_time
    t += dt
    if (desligando > 0) {   // já apagando: ninguém mais mexe
        desligando = min(1, desligando + dt * 2.5)
        if (desligando == 1 && raiz) { raiz.desligar() }
        return
    }
    if (aplicativoAberto()) { return }   // loja ou configurações no ar: o menu sai de cena
    if (store_busy()) { baixava = true }
    if (baixava && !store_busy()) {   // download acabou com o menu na tela: a lista de jogos mudou
        baixava = false
        listarJogos()
    }
    if (confirmando) {
        if (button_check_pressed(btn_a)) {
            desligando = 0.001
            audio_play_tone(392, 220)
        }
        if (button_check_pressed(btn_b)) {
            confirmando = false
            audio_play_tone(330, 60)
        }
        return
    }
    fade = min(1, fade + dt * 1.6)
    if (fade == 1) {   // sem entrada durante a transição do boot
        navegar()
    }
    var k = min(1, dt * 12)
    cx += (cat - cx) * k
    sy += (sel[cat] - sy) * k
}

function listarJogos() {
    var antes = ""                           // voltar de uma tela não pode mudar o jogo escolhido
    if (sel[1] < array_length(jogos)) { antes = jogos[sel[1]] }
    jogos = game_list()
    titulos = []
    for (var i = 0; i < array_length(jogos); i += 1) {
        array_push(titulos, game_title(jogos[i]))
    }
    if (antes == "") { antes = save_get("ultimo", "") }   // primeira lista: começa no último jogo aberto
    for (var i = 0; i < array_length(jogos); i += 1) {
        if (jogos[i] == antes) { sel[1] = i }
    }
    sel[1] = max(0, min(sel[1], max(0, array_length(jogos) - 1)))
}

function voltar() {   // a loja fechou: o menu volta, com a lista de jogos atualizada
    listarJogos()
    audio_play_tone(520, 50)
}

function navegar() {
    var c = cat
    if (button_check_pressed(btn_right) && cat < 2) { cat += 1 }
    if (button_check_pressed(btn_left) && cat > 0) { cat -= 1 }
    if (cat != c) {
        sy = sel[cat]
        tique()
    }
    if (button_check_pressed(btn_down) && sel[cat] < contar(cat) - 1) {
        sel[cat] += 1
        tique()
    }
    if (button_check_pressed(btn_up) && sel[cat] > 0) {
        sel[cat] -= 1
        tique()
    }
    if (button_check_pressed(btn_a)) {
        abrir(cat, sel[cat])
    }
    if (button_check_pressed(btn_y) && cat == 1 && array_length(jogos) > 0) {
        if (!telaJogo) {
            telaJogo = instance_create(Jogo)
            telaJogo.xmb = self
        }
        telaJogo.abrir(jogos[sel[1]])
        audio_play_tone(880, 60)
    }
}

function aplicativoAberto() {
    if (loja && loja.aberta) { return true }
    if (config && config.aberta) { return true }
    if (telaJogo && telaJogo.aberta) { return true }
    return false
}

function abrir(c, i) {
    if (c == 0 && i == 1) {
        confirmando = true
        audio_play_tone(880, 60)
    } else if (c == 0) {
        if (!config) {
            config = instance_create(Config)
            config.xmb = self
        }
        config.abrir()
        audio_play_tone(880, 60)
    } else if (c == 1) {
        if (array_length(jogos) > 0) {
            iniciar(jogos[i])
        } else {
            abrirLoja()   // sem jogo nenhum, o A leva para onde tem jogo
        }
    } else {
        abrirLoja()
    }
}

function abrirLoja() {
    if (!loja) {
        loja = instance_create(Loja)
        loja.xmb = self
    }
    loja.abrir()
    audio_play_tone(880, 60)
}

function iniciar(id) {
    audio_play_tone(988, 120)
    save_set("ultimo", id)
    save_set("visto_" + id, clock_date() + " " + clock_time())   // a tela do jogo mostra isso
    system_launch(id)
}

function tique() {
    audio_play_tone(660, 30)
}

// ---------- itens ----------

function contar(c) {
    if (c == 0) { return 2 }
    if (c == 1) { return max(1, array_length(jogos)) }
    return 1
}

function rotulo(c, i) {
    if (c == 0) { return ["Abrir configurações", "Desligar o console"][i] }
    if (c == 1) { return "Nenhum jogo instalado" }
    return "Abrir a loja"
}

function valor(c, i) {
    if (c == 0 && i == 0) { return volume + "%  " + temaNomes[tema] }
    return ""
}

function dica(c, i) {
    if (c == 0 && i == 0) { return "Volume, tema, loja e controles" }
    if (c == 0) { return "Fecha o console de verdade" }
    if (c == 1) { return "Nada aqui: baixe um na loja" }
    return "Baixar jogos novos"
}

// ---------- desenho ----------

function draw() {
    if (aplicativoAberto()) { return }   // quem desenha agora é a loja ou as configurações
    fundo()

    var hora = clock_date() + "  " + clock_time()
    draw_text(312 - string_width(hora, 10), 6, hora, 10, 0xFFFFFF)
    if (store_busy()) {   // a loja continua trabalhando com o menu na tela
        var baixa = "loja: conectando"
        if (store_progress() > 0) { baixa = "baixando " + floor(store_progress() * 100) + "%" }
        draw_text(312 - string_width(baixa, 9), 20, baixa, 9, 0xD8DCE4, 0.9)
    }

    for (var c = 0; c < 3; c += 1) {
        var x = col + (c - cx) * 66
        var s = 22
        var a = 0.5
        if (c == cat) {
            s = 30
            a = 1
        }
        draw_sprite(icones[c], x - s / 2, row - s / 2, s, s, a)
    }
    centrado(col, row + 16, cats[cat], 10, 1)

    var n = contar(cat)
    for (var i = 0; i < n; i += 1) {   // o item escolhido fica logo abaixo das categorias; os anteriores, acima
        var d = i - sy
        var y = 95 + d * 30
        if (d < 0) { y = 95 + d * 64 }
        if (d < -1) { y = 22 + (d + 1) * 30 }
        if (y > -20 && y < 178) {
            item(cat, i, y, i == sel[cat])
        }
    }

    var dicas = "A: abrir    Esq/Dir: muda"
    if (cat == 1 && array_length(jogos) > 0) { dicas = "A: jogar    Y: detalhes do jogo" }
    if (cat == 1 && array_length(jogos) == 0) { dicas = "A: abrir a loja" }
    draw_text(12, 166, dicas, 10, 0xFFFFFF, 0.8)

    if (confirmando) { pergunta() }
    if (fade < 1) {   // sai do preto do boot
        draw_rectangle(0, 0, 320, 180, 0x000000, 1 - fade)
    }
    if (desligando > 0) {   // ...e volta para o preto ao desligar
        draw_rectangle(0, 0, 320, 180, 0x000000, desligando)
    }
}

function pergunta() {
    caixaTema(30, 62, 260, 56)
    centrado(160, 70, "Desligar o console?", 12, 1)
    centrado(160, 88, "A: desligar     B: cancelar", 10, 0.9)
}

function item(c, i, y, on) {
    var a = 0.6
    if (on) {
        a = 1
        draw_rectangle(col - 24, y - 17, 262, 34, 0xFFFFFF, 0.07 + 0.04 * sin(t * 3))   // brilho pulsando
    }
    if (c == 1 && array_length(jogos) > 0) {
        var w = 44
        var h = 25
        if (on) {
            w = 58
            h = 33
        }
        if (!draw_sprite("games/" + jogos[i] + "/icon.png", col - 20, y - h / 2, w, h, a)) {
            draw_rectangle(col - 20, y - h / 2, w, h, 0x607090, a)
        }
        draw_text(col + 46, y - 9, titulos[i], 11, 0xFFFFFF, a)
        if (on) {
            var info = "Sem dados salvos"
            if (game_save_data(jogos[i]) != "") { info = "Dados salvos" }
            draw_text(col + 46, y + 4, info, 9, 0xD8DCE4, 0.9)
        }
        return
    }
    draw_sprite(icones[c], col - 8, y - 8, 16, 16, a)
    draw_text(col + 16, y - 9, rotulo(c, i), 11, 0xFFFFFF, a)
    var v = valor(c, i)
    if (v != "" && y > row) {   // itens acima das categorias mostram só o nome
        draw_text(302 - string_width(v, 10), y - 8, v, 10, 0xFFFFFF, a)
    }
    if (on) {
        draw_text(col + 16, y + 3, dica(c, i), 9, 0xD8DCE4, 0.9)
    }
}

function fundo() {   // gradiente na cor do tema + onda de luz ondulando, como no PS3
    var c = temaCores[tema]
    draw_gradient(0, 0, 320, 180, escuro(c, 0.2), c)
    for (var camada = 0; camada < 2; camada += 1) {
        var v = 0.35 + camada * 0.25
        for (var x = 0; x < 320; x += 2) {
            var y = 124 + sin(x * 0.018 + t * v + camada * 2.1) * (13 + camada * 5) + sin(x * 0.046 - t * 0.7) * 3
            draw_gradient(x, y - 10, 2, 10, 0xFFFFFF, 0xFFFFFF, 0, 0.12)
            draw_gradient(x, y, 2, 10, 0xFFFFFF, 0xFFFFFF, 0.12, 0)
        }
    }
}

// O fundo e o cabeçalho de qualquer aplicativo do firmware: assim o tema escolhido vale em todas as
// telas, não só no menu, e não há quatro cópias deste cabeçalho espalhadas.
function fundoApp(titulo, canto) {
    var c = temaCores[tema]
    draw_gradient(0, 0, 320, 180, escuro(c, 0.12), escuro(c, 0.4))
    draw_rectangle(0, 0, 320, 14, escuro(c, 0.5))
    draw_text(6, 2, titulo, 10, 0xFFFFFF)
    if (canto != "") { draw_text(314 - string_width(canto, 9), 3, canto, 9, 0xD8DCE4) }
}

// A caixa das perguntas (desligar, apagar save, desinstalar): mesma cara em qualquer tela, na cor do tema.
function caixaTema(x, y, w, h) {
    draw_rectangle(0, 0, 320, 180, 0x000000, 0.7)
    draw_rectangle(x, y, w, h, escuro(temaCores[tema], 0.15))
    draw_rectangle(x, y, w, 2, 0xFFFFFF, 0.5)
}

function corTema() {
    return temaCores[tema]
}

function escuro(c, k) {   // a mesma cor com brilho k (0..1)
    return make_color_rgb(floor(c / 65536) % 256 * k, floor(c / 256) % 256 * k, c % 256 * k)
}

function centrado(x, y, s, size, a) {
    draw_text(x - string_width(s, size) / 2, y, s, size, 0xFFFFFF, a)
}
