object Firmware

// Firmware do Doodle: tela de boot e, depois, o menu do sistema (Xmb.doo).
// É um "jogo especial" com privilégios de sistema (system_*).

var t = 0
var chimed = false
var menu

function create() {
    audio_play_tone(523, 150)
}

function step() {
    t += delta_time
    if (!menu && (t > 2.8 || button_check_pressed(btn_a) || button_check_pressed(btn_start))) {
        menu = instance_create(Xmb)
        menu.raiz = self
    }
}

function draw() {
    if (menu) {
        return
    }
    draw_clear(0x000000)
    var k = min(1, t / 1.2)   // o logo acende em 1.2 s
    if (k == 1 && !chimed) {
        audio_play_tone(784, 250)
        chimed = true
    }
    centered(60, "DOODLE", 34, make_color_rgb(255 * k, 255 * k, 255 * k))
    centered(104, "entertainment system", 9, make_color_rgb(120 * k, 140 * k, 200 * k))
}

// O console desliga quando a raiz do firmware morre: é o menu que pede, depois de confirmar.
function desligar() {
    instance_destroy()
}

function centered(y, s, size, color) {
    draw_text((320 - string_width(s, size)) / 2, y, s, size, color)
}
