object BasicCharacterController

// Personagem pronto do SDK (como os Starter Assets da Unity): anda, gira, pula e tem câmera em 3ª pessoa.
// Use direto com instance_create(BasicCharacterController, pos) ou estenda:
//     object Heroi extends BasicCharacterController
// e sobrescreva o que quiser (chame super.step() para manter o controle e a câmera).
use Rigidbody
use CapsuleCollider

var heading = 0            // para onde olha, em graus
var move_speed = 5         // unidades por segundo, para frente
var back_speed = 3         // para trás
var turn_speed = 140       // graus por segundo
var jump_speed = 7
var jump_sound = ""        // .wav opcional ao pular
var color = 0xF2F2F2
var controllable = true    // false: ignora o controle (menus, cenas)
var follow_camera = true   // câmera atrás do personagem
var camera_distance = 7
var camera_height = 3
var camera_yaw = 0         // giro da câmera em volta do personagem (analógico direito)
var look_speed = 120       // graus por segundo do analógico direito
var camera_y = 0           // altura da câmera, que segue com atraso (assim o pulo aparece na tela)

function create() {
    camera_y = position.y
}

function step() {
    if (controllable) {
        control()
    }
    if (follow_camera) {
        camera()
    }
}

function control() {   // controle "tank" estilo PS1: esquerda/direita giram, cima/baixo andam, A pula.
                       // Lê o analógico esquerdo, que sem controle são as próprias setas.
    var dt = delta_time
    heading -= stick_x() * turn_speed * dt
    var frente = stick_y()
    var speed = frente * move_speed
    if (frente < 0) { speed = frente * back_speed }
    var move = forward() * speed
    velocity.x = move.x
    velocity.z = move.z
    if (button_check_pressed(btn_a) && grounded) {
        velocity.y = jump_speed
        if (jump_sound != "") {
            audio_play_sound(jump_sound)
        }
    }
}

function camera() {   // o analógico direito gira em volta do personagem e sobe/desce o ponto de vista
    var dt = delta_time
    camera_yaw += look_x() * look_speed * dt
    camera_height = max(-1, min(9, camera_height + look_y() * 5 * dt))
    camera_y += (position.y - camera_y) * min(1, 4 * dt)
    var target = vec3(position.x, camera_y + 0.5, position.z)
    var rad = (heading + camera_yaw) * pi / 180
    var atras = vec3(sin(rad), 0, cos(rad)) * camera_distance
    camera_set(target - atras + vec3(0, camera_height, 0), target, 60)
}

function forward() {
    var rad = heading * pi / 180
    return vec3(sin(rad), 0, cos(rad))
}

function draw() {
    draw_mesh(mesh_capsule, position, vec3(0, heading, 0), 1, color)
}
