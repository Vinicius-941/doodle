object Button extends UIElement

// Botão: fica em destaque com o foco e A aperta. No seu step, leia `clicked` (vale um quadro).

var text = "Botão"
var size = 11
var background = 0x12141A
var clicked = false

function focusable() { return visible }

function activate() {
    clicked = true
    return true
}

function reset() {
    clicked = false
}

function paint(focused, t) {
    var bg = background
    var a = 0.8 * alpha
    if (focused) {
        bg = accent
        a = (0.8 + 0.2 * sin(t * 5)) * alpha
    }
    draw_rectangle(x, y, w, h, bg, a)
    if (focused) {
        draw_rectangle(x, y, w, 2, 0xFFFFFF, 0.7 * alpha)
        draw_rectangle(x, y + h - 2, w, 2, 0xFFFFFF, 0.7 * alpha)
    }
    draw_text(x + (w - string_width(text, size)) / 2, y + (h - size) / 2, text, size, color, alpha)
}
