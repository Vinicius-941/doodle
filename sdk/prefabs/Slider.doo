object Slider extends UIElement

// Barra de valor: com o foco, esquerda/direita mudam `value` entre min e max, de `step` em `step`.
// No seu step, leia `changed` (vale um quadro).

var label = ""
var value = 50
var min = 0
var max = 100
var step = 10
var size = 10
var background = 0x101828
var changed = false

function focusable() { return visible }

function adjust(d) {
    var v = max(min, min(max, value + d * step))
    changed = v != value
    value = v
    return true
}

function reset() {
    changed = false
}

function paint(focused, t) {
    var bg = background
    var a = 0.8 * alpha
    if (focused) {
        bg = accent
        a = (0.8 + 0.2 * sin(t * 5)) * alpha
    }
    draw_rectangle(x, y, w, h, bg, a)
    draw_text(x + 6, y + (h - size) / 2, label, size, color, alpha)
    var tx = x + w * 0.42   // trilho
    var tw = w * 0.4
    var k = (value - min) / (max - min)
    draw_rectangle(tx, y + h / 2 - 1, tw, 3, 0xFFFFFF, 0.25 * alpha)
    draw_rectangle(tx, y + h / 2 - 1, tw * k, 3, 0xFFFFFF, 0.9 * alpha)
    draw_rectangle(tx + tw * k - 2, y + h / 2 - 5, 5, 10, 0xFFFFFF, alpha)
    var s = "" + value
    draw_text(x + w - 6 - string_width(s, size), y + (h - size) / 2, s, size, color, alpha)
}
