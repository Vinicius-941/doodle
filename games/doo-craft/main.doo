object DooCraft

// All world generation, editing, collision, ray traversal and UI run in Doo.
// Cells occupy [x,x+1] [y,y+1] [z,z+1]. No entity per voxel.
var width = 48
var height = 32
var blocks = []
var surfaces = []
var heights = []
var stage = 0
var cursor = 0
var seed = 0
var edits = 0
var replay = 0
var position = vec3(24.5, 25, 24.5)
var yaw = 0
var pitch = -0.25
var velocityY = 0
var grounded = false
var selected = 1
var reach = 6
var target = vec3(-1, -1, -1)
var adjacent = vec3(-1, -1, -1)
var paused = false
var help = true
var menu
var resumeButton
var homeButton
var helpButton
var saveTimer = 0
var cooldown = 0
var names = ["Ar", "Grama", "Terra", "Pedra", "Areia", "Madeira", "Folhas", "Tijolos", "Rocha matriz"]
var textures = ["", "grass.bmp", "dirt.bmp", "stone.bmp", "sand.bmp", "wood.bmp", "leaves.bmp", "brick.bmp", "bedrock.bmp"]
var colors = [0, 0x74A943, 0x986B45, 0x92989C, 0xDBC586, 0x956335, 0x4A853E, 0xAC6850, 0x454952]

function create() {
    seed = store.load("seed", 73129)
    edits = store.load("edits", 0)
    store.save("seed", seed)
    menu = spawn(Canvas)
    var panel = menu.image("", 110, 75, 420, 330)
    panel.color = 0x101D25
    panel.alpha = 0.96
    menu.text("DOOCRAFT", 195, 95, 38)
    menu.text("Um mundo para construir", 192, 142, 19)
    resumeButton = menu.button("Continuar", 175, 185, 290, 44)
    helpButton = menu.button("Mostrar / ocultar controles", 175, 240, 290, 44)
    homeButton = menu.button("Salvar e voltar ao console", 175, 295, 290, 44)
    menu.text("Z confirma  /  Setas navegam", 192, 360, 17)
    menu.visible = false
    menu.active = false
}

function hash(x, z) {
    var v = math.sin(x * 127.1 + z * 311.7 + seed * 0.013) * 43758.5453
    return v - math.floor(v)
}

// Smooth interpolated value noise, four octaves. Seeded and deterministic.
function noise(x, z) {
    var ix = math.floor(x)
    var iz = math.floor(z)
    var u = x - ix
    var v = z - iz
    u = u * u * (3 - 2 * u)
    v = v * v * (3 - 2 * v)
    var a = hash(ix, iz) * (1 - u) + hash(ix + 1, iz) * u
    var b = hash(ix, iz + 1) * (1 - u) + hash(ix + 1, iz + 1) * u
    return a * (1 - v) + b * v
}

function terrainHeight(x, z) {
    return math.floor(4 + noise(x / 23, z / 23) * 13 + noise(x / 10, z / 10) * 7 + noise(x / 5, z / 5) * 3 + noise(x / 2, z / 2))
}

function index(x, y, z) { return (z * width + x) * height + y }
function inside(x, y, z) { return x >= 0 && z >= 0 && y >= 0 && x < width && z < width && y < height }
function get(x, y, z) {
    if (!inside(x, y, z)) { return 0 }
    return blocks[index(x, y, z)]
}
function set(x, y, z, kind) {
    if (inside(x, y, z)) { blocks[index(x, y, z)] = kind }
}

function generateColumn(c) {
    var x = c % width
    var z = math.floor(c / width)
    var h = terrainHeight(x, z)
    push(heights, h)
    push(surfaces, [])
    for (var y = 0; y < height; y += 1) {
        var kind = 0
        if (y == 0) { kind = 8 }
        else if (y < h - 3) { kind = 3 }
        else if (y < h) { kind = 2 }
        else if (y == h) {
            kind = 1
            if (h <= 13) { kind = 4 }
            if (h > 22) { kind = 3 }
        }
        push(blocks, kind)
    }
}

function tree(c) {
    var x = c % width
    var z = math.floor(c / width)
    var h = heights[c]
    if (x < 3 || z < 3 || x > width - 4 || z > width - 4 || h < 11 || h > 21) { return }
    if (math.abs(x - 24) < 3 && math.abs(z - 24) < 3) { return }
    if (hash(x * 3, z * 3) < 0.982) { return }
    for (var y = h + 3; y <= h + 5; y += 1) {
        for (var dx = -2; dx <= 2; dx += 1) {
            for (var dz = -2; dz <= 2; dz += 1) {
                if (math.abs(dx) + math.abs(dz) < 4 && get(x + dx, y, z + dz) == 0) { set(x + dx, y, z + dz, 6) }
            }
        }
    }
    for (var y = h + 1; y <= h + 4; y += 1) { set(x, y, z, 5) }
}

function rebuild(x, z) {
    if (x < 0 || z < 0 || x >= width || z >= width) { return }
    var list = []
    for (var y = 0; y < height; y += 1) {
        var b = get(x, y, z)
        if (b != 0) {
            if (get(x + 1, y, z) == 0 || get(x - 1, y, z) == 0 || get(x, y + 1, z) == 0 || get(x, y - 1, z) == 0 || get(x, y, z + 1) == 0 || get(x, y, z - 1) == 0) { push(list, y) }
        }
    }
    surfaces[z * width + x] = list
}

function loadStep() {
    if (stage == 0) {
        for (var i = 0; i < 32 && cursor < width * width; i += 1) { generateColumn(cursor) cursor += 1 }
        if (cursor == width * width) { cursor = 0 stage = 1 }
    } else if (stage == 1) {
        for (var i = 0; i < 64 && cursor < width * width; i += 1) { tree(cursor) cursor += 1 }
        if (cursor == width * width) { cursor = 0 stage = 2 }
    } else if (stage == 2) {
        for (var i = 0; i < 24 && replay < edits; i += 1) {
            var packed = store.load("edit" + replay, -1)
            if (packed >= 0) {
                var cell = math.floor(packed / 9)
                if (cell < len(blocks)) { blocks[cell] = packed % 9 }
            }
            replay += 1
        }
        if (replay >= edits) { stage = 3 }
    } else if (stage == 3) {
        for (var i = 0; i < 24 && cursor < width * width; i += 1) { rebuild(cursor % width, math.floor(cursor / width)) cursor += 1 }
        if (cursor == width * width) {
            stage = 4
            respawn()
            var p = vec3(store.load("px", position.x), store.load("py", position.y), store.load("pz", position.z))
            if (!collides(p)) { position = p }
            yaw = store.load("yaw", 0)
            pitch = store.load("pitch", -0.25)
            selected = math.max(1, math.min(7, store.load("selected", 1)))
        }
    }
}

function respawn() {
    // Pick an inland hill instead of spawning facing a wall in a valley.
    var best = -1
    var bx = 24
    var bz = 24
    for (var z = 12; z <= 35; z += 1) {
        for (var x = 12; x <= 35; x += 1) {
            var h = heights[z * width + x]
            if (h > best && get(x, h + 1, z) == 0 && get(x, h + 2, z) == 0) { best = h bx = x bz = z }
        }
    }
    var y = height - 3
    while (y > 0 && get(bx, y, bz) == 0) { y -= 1 }
    position = vec3(bx + 0.5, y + 1.01, bz + 0.5)
    velocityY = 0
}

// Swept movement uses short substeps; collision checks only the player's cells.
function collides(p) {
    if (p.x < 0.3 || p.z < 0.3 || p.x > width - 0.3 || p.z > width - 0.3 || p.y < 1 || p.y + 1.75 >= height) { return true }
    for (var x = math.floor(p.x - 0.28); x <= math.floor(p.x + 0.28); x += 1) {
        for (var z = math.floor(p.z - 0.28); z <= math.floor(p.z + 0.28); z += 1) {
            for (var y = math.floor(p.y); y <= math.floor(p.y + 1.72); y += 1) {
                if (get(x, y, z) != 0) { return true }
            }
        }
    }
    return false
}

function direction() { return vec3(math.sin(yaw) * math.cos(pitch), math.sin(pitch), math.cos(yaw) * math.cos(pitch)) }

// Exact voxel DDA: the previous cell is always face-adjacent to the hit.
function aim() {
    var origin = position + vec3(0, 1.6, 0)
    var d = direction()
    var x = math.floor(origin.x)
    var y = math.floor(origin.y)
    var z = math.floor(origin.z)
    var sx = 1
    var sy = 1
    var sz = 1
    if (d.x < 0) { sx = -1 }
    if (d.y < 0) { sy = -1 }
    if (d.z < 0) { sz = -1 }
    var dx = 1000000
    var dy = 1000000
    var dz = 1000000
    if (math.abs(d.x) > 0.000001) { dx = 1 / math.abs(d.x) }
    if (math.abs(d.y) > 0.000001) { dy = 1 / math.abs(d.y) }
    if (math.abs(d.z) > 0.000001) { dz = 1 / math.abs(d.z) }
    var tx = (x + 1 - origin.x) * dx
    var ty = (y + 1 - origin.y) * dy
    var tz = (z + 1 - origin.z) * dz
    if (sx < 0) { tx = (origin.x - x) * dx }
    if (sy < 0) { ty = (origin.y - y) * dy }
    if (sz < 0) { tz = (origin.z - z) * dz }
    var distance = 0
    target = vec3(-1, -1, -1)
    adjacent = vec3(x, y, z)
    while (distance <= reach) {
        if (get(x, y, z) != 0) { target = vec3(x, y, z) return }
        adjacent = vec3(x, y, z)
        if (tx <= ty && tx <= tz) { x += sx distance = tx tx += dx }
        else if (ty <= tz) { y += sy distance = ty ty += dy }
        else { z += sz distance = tz tz += dz }
    }
}

function edit(x, y, z, kind) {
    if (!inside(x, y, z) || y == 0 || get(x, y, z) == kind) { return false }
    var old = get(x, y, z)
    set(x, y, z, kind)
    if (kind != 0 && collides(position)) { set(x, y, z, old) return false }
    rebuild(x, z)
    rebuild(x - 1, z)
    rebuild(x + 1, z)
    rebuild(x, z - 1)
    rebuild(x, z + 1)
    store.save("edit" + edits, index(x, y, z) * 9 + kind)
    edits += 1
    store.save("edits", edits)
    return true
}

function savePlayer() {
    store.save("px", position.x)
    store.save("py", position.y)
    store.save("pz", position.z)
    store.save("yaw", yaw)
    store.save("pitch", pitch)
    store.save("selected", selected)
}

function pause(value) {
    paused = value
    menu.visible = value
    menu.active = value
    if (value) { savePlayer() menu.focus_on(resumeButton) }
}

function update() {
    if (stage < 4) { loadStep() return }
    if (input.just_pressed(Button.Start)) { pause(!paused) }
    if (paused) {
        if (resumeButton.clicked) { pause(false) }
        if (helpButton.clicked) { help = !help }
        if (homeButton.clicked) { savePlayer() destroy_self() }
    } else {
        var dt = math.min(time.delta, 0.05)
        cooldown = math.max(0, cooldown - dt)
        saveTimer += dt
        if (saveTimer > 8) { savePlayer() saveTimer = 0 }
        var forward = 0
        var strafe = 0
        if (input.pressed(Button.Select)) {
            if (input.pressed(Button.Up)) { pitch += dt * 1.6 }
            if (input.pressed(Button.Down)) { pitch -= dt * 1.6 }
            if (input.pressed(Button.Left)) { strafe = -1 }
            if (input.pressed(Button.Right)) { strafe = 1 }
        } else {
            if (input.pressed(Button.Up)) { forward = 1 }
            if (input.pressed(Button.Down)) { forward = -1 }
            if (input.pressed(Button.Left)) { yaw -= dt * 1.9 }
            if (input.pressed(Button.Right)) { yaw += dt * 1.9 }
        }
        pitch = math.max(-1.5, math.min(1.5, pitch))
        if (input.just_pressed(Button.A) && grounded) { velocityY = 7.4 grounded = false }
        var mx = (math.sin(yaw) * forward + math.cos(yaw) * strafe) * 4.3 * dt
        var mz = (math.cos(yaw) * forward - math.sin(yaw) * strafe) * 4.3 * dt
        velocityY = math.max(-18, velocityY - 21 * dt)
        var my = velocityY * dt
        var steps = math.max(1, math.floor(math.max(math.abs(my), math.max(math.abs(mx), math.abs(mz))) / 0.12) + 1)
        grounded = false
        for (var i = 0; i < steps; i += 1) {
            var p = position + vec3(mx / steps, 0, 0)
            if (!collides(p)) { position = p }
            p = position + vec3(0, 0, mz / steps)
            if (!collides(p)) { position = p }
            p = position + vec3(0, my / steps, 0)
            if (!collides(p)) { position = p }
            else { if (my < 0) { grounded = true } velocityY = 0 }
        }
        if (input.just_pressed(Button.L)) { selected -= 1 if (selected < 1) { selected = 7 } }
        if (input.just_pressed(Button.R)) { selected += 1 if (selected > 7) { selected = 1 } }
        aim()
        if (target.x >= 0) {
            if (input.just_pressed(Button.Y)) { selected = math.min(7, get(target.x, target.y, target.z)) }
            if (cooldown <= 0 && input.pressed(Button.X)) {
                if (edit(target.x, target.y, target.z, 0)) { audio.play(170, 35) }
                cooldown = 0.22
            } else if (cooldown <= 0 && input.pressed(Button.B)) {
                if (edit(adjacent.x, adjacent.y, adjacent.z, selected)) { audio.play(310, 35) }
                cooldown = 0.22
            }
        }
    }
    var eye = position + vec3(0, 1.6, 0)
    render.camera(eye, eye + direction(), 74)
    render.ambient(0xA0A3A6)
    render.light_directional(vec3(-0.5, -1, 0.3), 0xFFF2D6, 0.8)
}

function outline(p) {
    var center = p + vec3(0.5, 0.5, 0.5)
    for (var a = -1; a <= 1; a += 2) {
        for (var b = -1; b <= 1; b += 2) {
            render.mesh(Mesh.Cube, center + vec3(0, a * 0.503, b * 0.503), vec3(), vec3(1.03, 0.025, 0.025), 0x16212A)
            render.mesh(Mesh.Cube, center + vec3(a * 0.503, 0, b * 0.503), vec3(), vec3(0.025, 1.03, 0.025), 0x16212A)
            render.mesh(Mesh.Cube, center + vec3(a * 0.503, b * 0.503, 0), vec3(), vec3(0.025, 0.025, 1.03), 0x16212A)
        }
    }
}

function draw() {
    render.clear(0x91BCE0)
    if (stage < 4) {
        render.clear(0x142730)
        render.text(194, 158, "DOOCRAFT", 42, 0xF1E9D2)
        var labels = ["Criando montanhas e camadas...", "Plantando arvores...", "Restaurando suas construcoes...", "Preparando o mundo..."]
        render.text(152, 230, labels[stage], 20, 0xA6C5BC)
        render.rect(150, 277, 340, 8, 0x324A50)
        render.rect(150, 277, 340 * (stage + cursor / (width * width)) / 4, 8, 0x89BB63)
        render.text(246, 315, "Semente " + seed, 16, 0x9CAFAD)
        return
    }
    var facing = direction()
    var minX = math.max(0, math.floor(position.x) - 16)
    var maxX = math.min(width - 1, math.floor(position.x) + 16)
    var minZ = math.max(0, math.floor(position.z) - 16)
    var maxZ = math.min(width - 1, math.floor(position.z) + 16)
    for (var z = minZ; z <= maxZ; z += 1) {
        for (var x = minX; x <= maxX; x += 1) {
            var dx = x + 0.5 - position.x
            var dz = z + 0.5 - position.z
            if (dx * dx + dz * dz < 256) {
                var list = surfaces[z * width + x]
                for (var i = 0; i < len(list); i += 1) {
                    var y = list[i]
                    var dy = y + 0.5 - position.y - 1.6
                    // Broad 3D cone includes the entire camera frustum, even looking down.
                    if (dx * facing.x + dy * facing.y + dz * facing.z > -1.8) {
                        var kind = get(x, y, z)
                        if (kind == 1) {
                            render.mesh("grass.obj", vec3(x + 0.5, y + 0.5, z + 0.5), vec3(), 1, 0xFFFFFF)
                        } else {
                            render.mesh(Mesh.Cube, vec3(x + 0.5, y + 0.5, z + 0.5), vec3(), 1, 0xFFFFFF, textures[kind])
                        }
                    }
                }
            }
        }
    }
    if (target.x >= 0) { outline(target) }
    render.rect(310, 239, 21, 3, 0x17232A)
    render.rect(319, 230, 3, 21, 0x17232A)
    render.rect(311, 240, 19, 1, 0xFFFFFF)
    render.rect(320, 231, 1, 19, 0xFFFFFF)
    render.rect(12, 12, 206, 48, 0x142730, 0.8)
    render.text(23, 17, "DOOCRAFT / CRIATIVO", 17, 0xF2EBD9)
    render.text(23, 39, math.floor(position.x) + " / " + math.floor(position.y) + " / " + math.floor(position.z) + "   Seed " + seed, 12, 0xB7D3CA)
    if (help && !paused) {
        render.rect(12, 72, 296, 84, 0x142730, 0.75)
        render.text(22, 79, "Setas: andar / girar   Z: pular", 15, 0xFFFFFF)
        render.text(22, 98, "Backspace + setas: olhar / passo lateral", 14, 0xFFFFFF)
        render.text(22, 117, "A: quebrar   X: colocar   S: copiar bloco", 14, 0xFFFFFF)
        render.text(22, 136, "Q / W: bloco   Enter: menu   Esc: HOME", 14, 0xFFFFFF)
    }
    render.rect(148, 415, 344, 54, 0x142730, 0.9)
    for (var i = 1; i <= 7; i += 1) {
        var x = 154 + (i - 1) * 48
        if (i == selected) { render.rect(x - 2, 419, 46, 46, 0xE8D6A3) }
        render.rect(x, 421, 42, 42, 0x33474B)
        render.image(textures[i], x + 5, 426, 32, 32)
    }
    var label = names[selected] + "  /  ilimitado"
    render.rect(218, 385, 204, 25, 0x142730, 0.8)
    render.text(320 - render.text_width(label, 16) / 2, 389, label, 16, 0xFFFFFF)
}
