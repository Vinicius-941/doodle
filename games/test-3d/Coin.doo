object Coin

// Moeda: gatilho (trigger) que o jogador atravessa e coleta.
use SphereCollider

var trigger = true
var spin = 0

function step() {
    spin += 180 * delta_time
}

function collision(other) {
    if (object_name(other) == Player) {
        other.coins += 1
        audio_play_sound("moeda.wav")
        var brilho = instance_create(ParticleSystem, position)   // prefab do SDK
        brilho.color = 0xFFD23F
        brilho.size = 0.12
        brilho.burst(16)
        instance_destroy()
    }
}

function draw() {
    draw_mesh(mesh_cylinder, position, vec3(90, spin, 0), vec3(0.8, 0.06, 0.8), 0xFFD23F)
}
