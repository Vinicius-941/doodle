object Jogo

// Vale das Moedas: o jogo-base 3D do Doodle, feito só com o SDK.
// Pegue todas as moedas da fase antes do tempo acabar. Encostar numa bolota tira uma vida;
// cair em cima dela derruba a bolota. São três fases, e a última é de noite.

var estado = "titulo"   // titulo | jogando | fim
var fase = 0
var tempo = 0
var total = 0           // moedas da fase
var contadas = 0        // moedas já somadas aos pontos
var pisadas = 0         // bolotas já somadas aos pontos
var pontos = 0
var recorde = 0
var noite = false
var ps1 = false
var orbita = 0
var nomes = ["O vale", "Os morros", "A noite"]

var player
var chao
var casa
var lampada

var hud
var hFase
var hMoedas
var hPontos
var hTempo
var coracoes = []
var faixa               // nome da fase, que some aos poucos

var titulo
var bJogar
var bSairTitulo
var tRecorde

var pausa
var bContinuar
var bPs1
var sMusica
var bTitulo
var bSair

var fim
var tFim
var tMotivo
var tPontos
var tRecordeFim
var bDeNovo
var bVoltar

function create() {
    recorde = save_get("recorde", 0)
    cenario()
    player = instance_create(Player, vec3(0, 1, 0))
    interface()
    mostrarTitulo()
}

// ---------- cenário fixo (fica de pé nas três fases) ----------

function cenario() {
    chao = instance_create(Terrain, vec3(0, 0, 0))     // vale plano no meio, morros em volta
    chao.heightmap = "relevo.png"
    chao.size = vec3(90, 7, 90)
    chao.texture = "grama.png"
    chao.tiling = 22
    chao.texture2 = "pedra.bmp"   // pedra aparecendo nos morros: o próprio relevo serve de máscara
    chao.mask = "relevo.png"
    chao.build()

    for (var i = 0; i < 3; i += 1) {         // escada de caixas
        var h = i + 1
        bloco(vec3(5 + i * 2, h / 2, 6), vec3(2, h, 2), 0xFFFFFF, "caixa.png")
    }
    for (var i = 0; i < 12; i += 1) {        // anel de pilares
        var a = i * pi / 6
        bloco(vec3(sin(a) * 16, 2, cos(a) * 16), vec3(1, 4, 1), 0xC8C0B0, "")
    }

    casa = instance_create(Prop, vec3(-7, 1.6, 8))     // modelo .obj com rádio tocando dentro
    casa.model = "casa.obj"
    casa.size = vec3(3, 3.2, 3)
    casa.rotation = vec3(0, 90, 0)
    casa.sound = "musica.wav"
    casa.loop = true
    casa.range = 22
    casa.tocar()

    for (var i = 0; i < 3; i++) {                      // pássaros dando voltas lá em cima
        var passaro = instance_create(Passaro, vec3(0, 0, 0))
        passaro.fase = i * 2.1
        passaro.raio = 22 + i * 5
        passaro.altura = 10 + i * 2
    }

    var fumaca = instance_create(ParticleSystem, vec3(-7, 3.4, 8))
    fumaca.color = 0xB8B8B8
    fumaca.size = 0.3
    fumaca.speed = 1.2
    fumaca.spread = 0.25
    fumaca.gravity = -1.5
    fumaca.lifetime = 2.2
    fumaca.rate = 10
    fumaca.emitting = true

    lampada = instance_create(Light, vec3(-4.8, 1.8, 8))   // acende só na fase da noite
    lampada.color = 0xFFB060
    lampada.range = 9
    lampada.intensity = 1.5
    lampada.enabled = false
}

function bloco(pos, tam, cor, textura) {
    var b = instance_create(Block, pos)
    b.size = tam
    b.color = cor
    b.texture = textura
}

// ---------- telas ----------

function interface() {
    hud = instance_create(Canvas)
    hud.active = false
    hFase = hud.text("", 8, 6, 10)
    hMoedas = hud.text("", 8, 18, 14)
    hPontos = centrado(hud, "", 6, 13)
    hTempo = hud.text("", 276, 6, 15)
    for (var i = 0; i < 3; i += 1) {
        array_push(coracoes, hud.image("coracao.png", 276 + i * 14, 26, 12, 12))
    }
    faixa = centrado(hud, "", 74, 20)
    faixa.color = 0xFFE070

    titulo = instance_create(Canvas)
    escurecer(titulo, 0.35)
    centrado(titulo, "Vale das Moedas", 22, 26)
    centrado(titulo, "Pegue as moedas. Pule nas bolotas!", 54, 10)
    bJogar = titulo.button("Jogar", 110, 78, 100, 20)
    bSairTitulo = titulo.button("Sair", 110, 102, 100, 20)
    tRecorde = centrado(titulo, "", 130, 10)
    centrado(titulo, "Setas: andar   Z: pular   Enter: pausa", 166, 10)

    pausa = instance_create(Canvas)
    escurecer(pausa, 0.6)
    centrado(pausa, "Pausa", 20, 20)
    bContinuar = pausa.button("Continuar", 90, 46, 140, 19)
    bPs1 = pausa.button("", 90, 69, 140, 19)
    sMusica = pausa.slider("Música", 90, 92, 140, 0, 100, 100)
    bTitulo = pausa.button("Voltar ao título", 90, 115, 140, 19)
    bSair = pausa.button("Sair do jogo", 90, 138, 140, 19)

    fim = instance_create(Canvas)
    escurecer(fim, 0.65)
    tFim = centrado(fim, "", 24, 22)
    tMotivo = centrado(fim, "", 52, 10)
    tPontos = centrado(fim, "", 68, 15)
    tRecordeFim = centrado(fim, "", 90, 10)
    tRecordeFim.color = 0xFFE070
    bDeNovo = fim.button("Jogar de novo", 110, 112, 100, 20)
    bVoltar = fim.button("Voltar ao título", 110, 138, 100, 20)
}

function centrado(canvas, s, y, tamanho) {
    var t = canvas.text(s, 0, y, tamanho)
    t.w = 320
    t.align = "center"
    return t
}

function escurecer(canvas, a) {   // painel escuro por cima do jogo
    var e = canvas.image("", 0, 0, 320, 180)
    e.color = 0x000000
    e.alpha = a
}

function menu(c, foco) {   // um menu por vez (nil = nenhum)
    titulo.visible = false
    titulo.active = false
    pausa.visible = false
    pausa.active = false
    fim.visible = false
    fim.active = false
    if (c) {
        c.visible = true
        c.active = true
        c.focus_on(foco)
    }
}

// ---------- estados ----------

function mostrarTitulo() {
    estado = "titulo"
    fase = 0
    limpar()
    time_set_scale(1)
    noite = false
    lampada.enabled = false
    player.controllable = false
    player.follow_camera = false
    reposicionar()
    tRecorde.text = "Recorde: " + recorde
    hud.visible = false
    menu(titulo, bJogar)
}

function comecar() {
    pontos = 0
    player.vidas = 3
    carregarFase(1)
}

function carregarFase(n) {
    limpar()
    fase = n
    estado = "jogando"
    noite = n == 3
    lampada.enabled = noite
    player.coins = 0
    player.pisoes = 0
    player.controllable = true
    player.follow_camera = true
    contadas = 0
    pisadas = 0
    reposicionar()
    hud.visible = true
    faixa.text = "Fase " + n + " · " + nomes[n - 1]
    faixa.alpha = 1
    menu(nil, nil)
    if (n == 1) {
        tempo = 60
        anel(6, 9, 0.5)
        moedaEm(vec3(9, 3.8, 6))            // no alto da escada
        bolota(0, -9, 2, 6, 0x7BD36B)
        bolota(-11, -3, 2, 6, 0x7BD36B)
    } else if (n == 2) {
        tempo = 80
        anel(5, 27, 0.3)                    // nos morros
        anel(2, 6, 1.2)
        moedaEm(vec3(9, 3.8, 6))
        bolota(8, 2, 2.6, 7, 0xF0A040)
        bolota(-8, -6, 2.6, 7, 0xF0A040)
        bolota(20, -14, 2.6, 8, 0xF0A040)
        bolota(-20, 12, 2.6, 8, 0xF0A040)
    } else {
        tempo = 95
        anel(4, 28, 0.9)
        anel(3, 12, 0.2)
        moedaEm(vec3(-7, 1.2, 12))          // atrás da casa
        bolota(6, 6, 3.1, 9, 0xB070F0)
        bolota(-6, 8, 3.1, 9, 0xB070F0)
        bolota(12, -10, 3.1, 9, 0xB070F0)
        bolota(-14, -8, 3.1, 9, 0xB070F0)
        bolota(24, 6, 3.1, 9, 0xB070F0)
        bolota(-22, -18, 3.1, 9, 0xB070F0)
    }
}

function terminar(venceu, motivo) {
    estado = "fim"
    player.controllable = false
    if (venceu) {
        tFim.text = "Você venceu!"
        audio_play_tone(1318, 400)
    } else {
        tFim.text = "Fim de jogo"
        audio_play_tone(196, 500)
    }
    tMotivo.text = motivo
    tPontos.text = "Pontos: " + pontos
    if (pontos > recorde) {
        recorde = pontos
        save_set("recorde", recorde)
        tRecordeFim.text = "Novo recorde!"
    } else {
        tRecordeFim.text = "Recorde: " + recorde
    }
    menu(fim, bDeNovo)
}

function pausar(p) {
    player.controllable = !p
    if (p) {
        time_set_scale(0)
        rotulos()
        menu(pausa, bContinuar)
    } else {
        time_set_scale(1)
        menu(nil, nil)
    }
}

function rotulos() {
    if (ps1) { bPs1.text = "Efeito PS1: ligado" } else { bPs1.text = "Efeito PS1: desligado" }
}

// ---------- montagem das fases ----------

function limpar() {   // troca de fase: moedas e bolotas vão embora sem contar ponto
    with (Coin) { instance_destroy() }
    with (Blob) { instance_destroy() }
    total = 0
}

function anel(qtd, raio, giro) {   // moedas em círculo, acompanhando o relevo
    for (var i = 0; i < qtd; i += 1) {
        var a = i * 2 * pi / qtd + giro
        moeda(sin(a) * raio, cos(a) * raio)
    }
}

function moeda(x, z) {
    var y = chao.height_at(x, z)
    if (y == nil) { y = 0 }
    moedaEm(vec3(x, y + 1.2, z))
}

function moedaEm(pos) {
    instance_create(Coin, pos)
    total += 1
}

function bolota(x, z, velocidade, alcance, cor) {
    var y = chao.height_at(x, z)
    if (y == nil) { y = 0 }
    var b = instance_create(Blob, vec3(x, y + 0.6, z))
    b.alvo = player
    b.chao = chao
    b.casa = b.position
    b.velocidade = velocidade
    b.alcance = alcance
    b.cor = cor
}

function reposicionar() {
    player.position = vec3(0, 1, 0)
    player.velocity = vec3(0, 0, 0)
    player.heading = 0
    player.camera_y = 1
    player.invencivel = 0
    player.atordoado = 0
}

// ---------- quadro a quadro ----------

function step() {
    if (estado == "titulo") {
        orbita += delta_time_real * 0.12       // câmera girando em volta do vale
        camera_set(vec3(sin(orbita) * 30, 16, cos(orbita) * 30), vec3(0, 1, 0), 55)
        if (bJogar.clicked) { comecar() }
        if (bSairTitulo.clicked) { instance_destroy() }
    } else if (estado == "jogando") {
        jogar()
    } else {
        if (bDeNovo.clicked) { comecar() }
        if (bVoltar.clicked) { mostrarTitulo() }
    }
    luzes()
    atualizarHud()
}

function jogar() {
    if (button_check_pressed(btn_start)) { pausar(!pausa.visible) }
    if (pausa.visible) {
        if (bContinuar.clicked) { pausar(false) }
        if (bPs1.clicked) {
            ps1 = !ps1
            rotulos()
        }
        if (sMusica.changed) { casa.volume = sMusica.value / 100 }
        if (bTitulo.clicked) {
            pausar(false)
            mostrarTitulo()
        }
        if (bSair.clicked) { instance_destroy() }
        return
    }

    tempo -= delta_time
    if (player.coins > contadas) {
        pontos += (player.coins - contadas) * 100
        contadas = player.coins
    }
    if (player.pisoes > pisadas) {
        pontos += (player.pisoes - pisadas) * 50
        pisadas = player.pisoes
    }

    if (total > 0 && player.coins >= total) {
        pontos += floor(tempo) * 10       // bônus pelo tempo que sobrou
        if (fase < 3) {
            audio_play_tone(1046, 350)
            carregarFase(fase + 1)
        } else {
            terminar(true, "Você limpou as três fases")
        }
    } else if (player.vidas <= 0) {
        terminar(false, "Acabaram as vidas")
    } else if (tempo <= 0) {
        terminar(false, "O tempo acabou")
    }
}

function luzes() {
    if (ps1) { shader_set("ps1") }
    if (noite) {
        light_ambient(0x141A28)
        light_directional(vec3(0.4, -1, 0.3), 0x6070B0, 0.5)   // lua
        if (player.controllable) {                                     // lanterna do jogador
            light_spot(player.position + vec3(0, 0.6, 0), player.forward() + vec3(0, -0.3, 0), 0xFFF0D0, 18, 50, 1.4)
        }
    }
}

function atualizarHud() {
    if (fase > 0) {
        hFase.text = "Fase " + fase + " · " + nomes[fase - 1]
    }
    hMoedas.text = "Moedas " + player.coins + " / " + total
    hPontos.text = "" + pontos
    hTempo.text = relogio(tempo)
    if (tempo < 10) { hTempo.color = 0xFF6A6A } else { hTempo.color = 0xFFFFFF }
    for (var i = 0; i < 3; i += 1) {
        var c = coracoes[i]
        c.visible = i < player.vidas
    }
    faixa.alpha = max(0, faixa.alpha - delta_time_real * 0.5)
}

function relogio(s) {
    var t = max(0, floor(s))
    var m = floor(t / 60)
    var r = t % 60
    if (r < 10) { return m + ":0" + r }
    return m + ":" + r
}

function draw() {
    if (noite) {
        draw_clear(0x0A0F1E)
    } else {
        draw_clear(0x7FB2E5)
    }
}
