object Test3D

// Fase de teste 3D: monta o cenário com spawn, o HUD e o menu de pausa (Canvas, prefab de UI do SDK),
// e cuida do dia/noite. A câmera vem do Player (BasicCharacterController, prefab do SDK).

var player
var casa
var lampada
var total = 0
var noite = false   // de noite: lua fraca, a lâmpada da casa acende e o jogador ganha uma lanterna
var ps1 = false     // shader "ps1": vértices tremendo e textura afim, como no PS1 de verdade

var hud             // Canvas sem controle: só mostra
var moedas
var parabens
var marcaPs1
var pausa           // Canvas do menu de pausa (Start)
var bContinuar
var bNoite
var bPs1
var sMusica
var bSair

function create() {
    block(vec3(0, -0.5, 0), vec3(80, 1, 80), 0x5E9E48, "")   // chão

    for (var i = 0; i < 3; i += 1) {                          // escada de caixas: pule de uma pra outra
        var h = i + 1
        block(vec3(5 + i * 2, h / 2, 6), vec3(2, h, 2), 0xFFFFFF, "caixa.png")
    }
    coin(vec3(9, 3.8, 6))                                     // prêmio no alto da escada

    for (var i = 0; i < 12; i += 1) {                         // anel de pilares
        var a = i * math.pi / 6
        block(vec3(math.sin(a) * 16, 2, math.cos(a) * 16), vec3(1, 4, 1), 0xC8C0B0, "")
    }

    casa = spawn(Prop, vec3(-7, 1.6, 8))       // modelo .obj texturizado; o colisor vai de y = 0 a 3.2
    casa.model = "casa.obj"
    casa.size = vec3(3, 3.2, 3)
    casa.rotation = vec3(0, 90, 0)             // porta virada para o centro
    casa.sound = "musica.wav"                  // rádio tocando dentro da casa: chegue perto pra ouvir
    casa.loop = true
    casa.range = 22
    casa.tocar()

    var fumaca = spawn(ParticleSystem, vec3(-7, 3.4, 8))   // fumaça saindo do telhado (prefab do SDK, jato contínuo)
    fumaca.color = 0xB8B8B8
    fumaca.size = 0.3
    fumaca.speed = 1.2
    fumaca.spread = 0.25
    fumaca.gravity = -1.5                                   // negativa: sobe
    fumaca.lifetime = 2.2
    fumaca.rate = 10
    fumaca.emitting = true

    lampada = spawn(Light, vec3(-4.8, 1.8, 8))              // lâmpada na porta da casa (prefab Light, tipo Point)
    lampada.color = 0xFFB060
    lampada.range = 9
    lampada.intensity = 1.5
    lampada.enabled = false

    for (var i = 0; i < 6; i += 1) {                      // moedas em círculo
        var a = i * math.pi / 3 + 0.5
        coin(vec3(math.sin(a) * 9, 1, math.cos(a) * 9))
    }
    player = spawn(Player, vec3(0, 1, 0))

    hud = spawn(Canvas)
    hud.active = false
    moedas = hud.text("", 20, 16, 26)
    parabens = hud.text("Você pegou todas!", 20, 50, 22)
    parabens.color = 0xFFE070
    marcaPs1 = hud.text("PS1", 560, 16, 22)
    marcaPs1.color = 0xFFE070
    hud.text("Setas: andar/girar      Z: pular      Enter: pausa      Esc: HOME", 20, 448, 15)

    pausa = spawn(Canvas)
    var fundo = pausa.image("", 0, 0, 640, 480)            // painel escuro por cima do jogo
    fundo.color = 0x000000
    fundo.alpha = 0.6
    var titulo = pausa.text("Pausa", 0, 110, 40)
    titulo.w = 640
    titulo.align = "center"
    bContinuar = pausa.button("Continuar", 180, 180, 280, 44)
    bNoite = pausa.button("", 180, 232, 280, 44)
    bPs1 = pausa.button("", 180, 284, 280, 44)
    sMusica = pausa.slider("Música", 180, 336, 280, 0, 100, 100)
    bSair = pausa.button("Sair para o menu", 180, 388, 280, 44)
    rotulos()
    pausar(false)
}

function block(pos, size, color, texture) {
    var b = spawn(Block, pos)
    b.size = size
    b.color = color
    b.texture = texture
}

function coin(pos) {
    spawn(Coin, pos)
    total += 1
}

function update() {
    moedas.text = "Moedas: " + player.coins + " / " + total
    parabens.visible = player.coins == total
    marcaPs1.visible = ps1

    if (input.just_pressed(Button.Start)) { pausar(!pausa.visible) }
    if (bContinuar.clicked) { pausar(false) }
    if (bNoite.clicked) {
        noite = !noite
        lampada.enabled = noite
        rotulos()
    }
    if (bPs1.clicked) {
        ps1 = !ps1
        rotulos()
    }
    if (sMusica.changed) { casa.volume = sMusica.value / 100 }
    if (bSair.clicked) { destroy_self() }   // a raiz do jogo sumiu: o console volta ao menu

    if (ps1) {
        render.set_shader("ps1")
    }
    if (noite) {   // luzes valem só para este quadro: declaradas de novo a cada update
        render.ambient(0x141A28)
        render.light_directional(vec3(0.4, -1, 0.3), 0x6070B0, 0.5)   // lua
        render.light_spot(player.position + vec3(0, 0.6, 0), player.forward() + vec3(0, -0.3, 0), 0xFFF0D0, 18, 50, 1.4)  // lanterna
    }
}

function pausar(p) {   // tempo parado e personagem sem controle enquanto o menu está aberto
    pausa.visible = p
    pausa.active = p
    player.controllable = !p
    if (p) {
        time.set_scale(0)
        pausa.focus_on(bContinuar)
    } else {
        time.set_scale(1)
    }
}

function rotulos() {
    if (noite) { bNoite.text = "Hora: noite" } else { bNoite.text = "Hora: dia" }
    if (ps1) { bPs1.text = "Efeito PS1: ligado" } else { bPs1.text = "Efeito PS1: desligado" }
}

function draw() {
    if (noite) {
        render.clear(0x0A0F1E)
    } else {
        render.clear(0x7FB2E5)
    }
}
