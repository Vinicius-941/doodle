object Test3D

// Fase de teste 3D: monta o cenário com spawn, e cuida da câmera e do HUD.

var player
var total = 0
var camy = 1

function create() {
    block(vec3(0, -0.5, 0), vec3(80, 1, 80), 0x5E9E48, "")   // chão

    for (var i = 0; i < 3; i += 1) {                          // escada de caixas: pule de uma pra outra
        var h = i + 1
        block(vec3(5 + i * 2, h / 2, 6), vec3(2, h, 2), 0xFFFFFF, "caixa.png")
    }
    coin(vec3(9, 3.8, 6))                                     // prêmio no alto da escada

    for (var i = 0; i < 12; i += 1) {                         // anel de pilares
        var a = i * math.pi / 6
        block(vec3(math.sin(a) * 16, 2, math.cos(a) * 16), vec3(1, 4, 1), 0xC8C0B0, "")
    }

    var casa = spawn(Prop, vec3(-7, 1.6, 8))   // modelo .obj texturizado; o colisor vai de y = 0 a 3.2
    casa.model = "casa.obj"
    casa.size = vec3(3, 3.2, 3)
    casa.rotation = vec3(0, 90, 0)             // porta virada para o centro
    for (var i = 0; i < 6; i += 1) {                      // moedas em círculo
        var a = i * math.pi / 3 + 0.5
        coin(vec3(math.sin(a) * 9, 1, math.cos(a) * 9))
    }
    player = spawn(Player, vec3(0, 1, 0))
}

function block(pos, size, color, texture) {
    var b = spawn(Block, pos)
    b.size = size
    b.color = color
    b.texture = texture
}

function coin(pos) {
    spawn(Coin, pos)
    total += 1
}

function draw() {
    // câmera atrás do jogador; a altura segue com atraso, então o pulo aparece e a escada também
    var p = player.position
    camy += (p.y - camy) * 4 * time.delta
    var target = vec3(p.x, camy + 0.5, p.z)
    render.clear(0x7FB2E5)
    render.camera(target - player.forward() * 7 + vec3(0, 3, 0), target, 60)

    render.text(20, 16, "Moedas: " + player.coins + " / " + total, 26, 0xFFFFFF)
    if (player.coins == total) {
        render.text(20, 50, "Você pegou todas!", 22, 0xFFE070)
    }
    render.text(20, 448, "Setas: andar/girar    Z: pular    Esc: HOME", 15, 0xFFFFFF)
}
