object Test3D

// Jogo-base 3D de teste: controle "tank" estilo PS1, pulo com gravidade e câmera em 3ª pessoa.

var player = vec3(0, 1, 0)
var heading = 0   // para onde o jogador olha, em graus
var vy = 0        // velocidade vertical
var spin = 0

function update() {
    var dt = time.delta
    spin += 90 * dt

    if (input.pressed(Button.Left))  { heading += 140 * dt }
    if (input.pressed(Button.Right)) { heading -= 140 * dt }
    var rad = heading * math.pi / 180
    var forward = vec3(math.sin(rad), 0, math.cos(rad))
    if (input.pressed(Button.Up))   { player += forward * 5 * dt }
    if (input.pressed(Button.Down)) { player -= forward * 3 * dt }

    if (input.just_pressed(Button.A) && player.y <= 1) { vy = 7 }
    vy -= 20 * dt
    player.y += vy * dt
    if (player.y < 1) {
        player.y = 1
        vy = 0
    }
    if (input.just_pressed(Button.B)) { destroy_self() }

    // câmera atrás do jogador, sem acompanhar o pulo (assim o pulo aparece na tela)
    var ground = vec3(player.x, 1, player.z)
    render.clear(0x7FB2E5)
    render.camera(ground - forward * 7 + vec3(0, 3.5, 0), ground + vec3(0, 0.5, 0), 60)
    render.mesh(Mesh.Plane, vec3(0, 0, 0), vec3(0, 0, 0), vec3(400, 1, 400), 0x5E9E48)

    // anel de pilares
    for (var i = 0; i < 12; i += 1) {
        var a = i * math.pi / 6
        render.mesh(Mesh.Cylinder, vec3(math.sin(a) * 15, 1, math.cos(a) * 15), vec3(0, 0, 0), 1, 0xC8C0B0)
    }
    render.mesh(Mesh.Cube, vec3(4, 1, 6), vec3(0, spin, 0), 1.5, 0xE0A040)
    render.mesh(Mesh.Sphere, vec3(-4, 1 + math.abs(math.sin(spin * math.pi / 90)) * 1.5, 6), vec3(0, 0, 0), 1.5, 0xD85A5A)

    render.mesh(Mesh.Capsule, player, vec3(0, heading, 0), 1, 0xF2F2F2)

    // HUD 2D por cima da cena
    render.text(20, 16, "Teste 3D", 26, 0xFFFFFF)
    render.text(20, 448, "Setas: andar/girar    Z: pular    X: sair    Esc: HOME", 15, 0xFFFFFF)
}
