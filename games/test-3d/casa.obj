# Casa low-poly do jogo de teste: 3 x 3.2 x 3, origem no centro da base, porta virada para +z
mtllib casa.mtl

# paredes: base (1-4) e topo (5-8)
v -1.5 0 -1.5
v  1.5 0 -1.5
v  1.5 0  1.5
v -1.5 0  1.5
v -1.5 2 -1.5
v  1.5 2 -1.5
v  1.5 2  1.5
v -1.5 2  1.5
# pontas das empenas (9-10)
v -1.5 3.2 0
v  1.5 3.2 0
# telhado com beiral (11-16)
v -1.7 3.2 0
v  1.7 3.2 0
v -1.7 1.9 1.8
v  1.7 1.9 1.8
v -1.7 1.9 -1.8
v  1.7 1.9 -1.8
# porta (17-20) e janelas laterais (21-28), rentes às paredes
v -0.4 0 1.51
v  0.4 0 1.51
v  0.4 1.3 1.51
v -0.4 1.3 1.51
v 1.51 0.9 0.5
v 1.51 0.9 -0.5
v 1.51 1.5 -0.5
v 1.51 1.5 0.5
v -1.51 0.9 -0.5
v -1.51 0.9 0.5
v -1.51 1.5 0.5
v -1.51 1.5 -0.5

# UVs: tijolos repetem 1.5x na largura; o telhado 1.7x
vt 0 0
vt 1.5 0
vt 1.5 1
vt 0 1
vt 0.75 1.6
vt 0 0
vt 1.7 0
vt 1.7 1.1
vt 0 1.1

usemtl parede
f 4/1 3/2 7/3 8/4
f 2/1 1/2 5/3 6/4
f 3/1 2/2 6/3 7/4
f 1/1 4/2 8/3 5/4
f 7/4 6/3 10/5
f 5/4 8/3 9/5

usemtl telhado
f 13/6 14/7 12/8 11/9
f 16/6 15/7 11/8 12/9

usemtl porta
f 17 18 19 20

usemtl janela
f 21 22 23 24
f 25 26 27 28
