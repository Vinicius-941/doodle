object Player extends BasicCharacterController

// O herói do teste: o personagem pronto do SDK (andar, pular, câmera) + as moedas coletadas.
var jump_sound = "pulo.wav"
var coins = 0

function update() {
    super.update()
    if (position.y < -20) {   // caiu pra fora do mapa
        position = vec3(0, 2, 0)
    }
}
