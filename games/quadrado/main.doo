object Quadrado

// Prova de conceito: um quadrado que se move com o direcional.

var x = 300
var y = 220
var speed = 240
var colors = [0xFFCC00, 0x40E0D0, 0xFF5080]
var ci = 0

function create() {
    ci = save_get("cor", 0) % array_length(colors)   // a última cor escolhida fica salva
    show_debug_message("quadrado: create")
}

function step() {
    if (button_check(btn_right)) { x += speed * delta_time }
    if (button_check(btn_left))  { x -= speed * delta_time }
    if (button_check(btn_down))  { y += speed * delta_time }
    if (button_check(btn_up))    { y -= speed * delta_time }
    x = clamp(x, 0, 640 - 40)
    y = clamp(y, 0, 480 - 40)

    if (button_check_pressed(btn_a)) {
        ci = (ci + 1) % array_length(colors)
        save_set("cor", ci)
        audio_play_tone(440 + ci * 220, 60)
    }
    if (button_check_pressed(btn_b)) {
        instance_destroy()
    }

    draw_clear(0x101820)
    draw_rectangle(x, y, 40, 40, colors[ci])
    draw_text(20, 16, "Quadrado", 26, 0xFFFFFF)
    draw_text(20, 448, "Setas: mover    Z: cor    X: sair    Esc: HOME", 15, 0x8090A0)
}

function destroy() {
    show_debug_message("quadrado: destroy")
}

function clamp(v, lo, hi) {
    if (v < lo) { return lo }
    if (v > hi) { return hi }
    return v
}
